{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamer Radio",
  "version": "1.0.0",
  "identifier": "app.streamerradio.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Streamer Radio",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: ws://127.0.0.1:4455; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
